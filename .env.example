# Copie para .env.local e preencha com o firebaseConfig do seu app web
# (Console Firebase → Configurações do projeto → Seus apps → SDK setup).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "true" para usar os emuladores locais (firebase emulators:start) no `npm run dev`.
VITE_USE_FIREBASE_EMULATORS=false

# App Check (reCAPTCHA Enterprise): chave de site criada no Google Cloud.
VITE_RECAPTCHA_SITE_KEY=
# Só desenvolvimento: token de depuração registrado no App Check (nunca vai para o build).
VITE_APPCHECK_DEBUG_TOKEN=
# Opcional: modelo do Firebase AI Logic (padrão em src/lib/ai.ts).
VITE_AI_MODEL=
